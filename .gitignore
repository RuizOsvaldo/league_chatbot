# Chatbot Course - Git Ignore File
# The LEAGUE of Amazing Programmers
# This file tells Git what NOT to include when sharing/forking

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv
pip-log.txt
pip-delete-this-directory.txt

# Streamlit
.streamlit/secrets.toml
.streamlit/config.toml.local

# Database Files - These are created by the app
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Jupyter Notebooks (if any)
.ipynb_checkpoints/
*.ipynb

# Logs and Debug Files
*.log
debug.log
error.log

# User Data and Exports
chat_exports/
user_data/
backups/
*.csv
*.json
*.pdf
*.txt
!requirements.txt
!README.md
!DEVELOPMENT.md

# Personal Files
notes.md
todo.md
personal_notes/
test_*.py

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Temporary Files
*.tmp
*.temp
*.bak
*.backup
*~
.cache/

# Security and Secrets
secrets.py
config.ini
.env.local
.env.production
credentials.json
token.json

# Media Files (usually too large)
*.mp4
*.mov
*.avi
*.mp3
*.wav
*.zip
*.rar
*.tar.gz

# Keep These Files
# The ! means "don't ignore these"
!examples/*.py
!lessons/*.py
!.gitignore
!.devcontainer/

# Note for Students:
# This file ensures that when you fork or share your project:
# - Your personal chat data stays private
# - Database files aren't shared (each person creates their own)
# - Temporary files don't clutter the repository
# - Your code and documentation are properly shared